# Reverse proxy for both hosts, with automatic HTTPS (Caddy requests and
# renews Let's Encrypt certificates on its own - no certbot, no manual
# renewal cron) via the default HTTP-01 challenge, which just needs port 80
# reachable and DNS already pointing here - no DNS provider API/token
# needed. Replace both domains below with your real ones if this ever
# serves a different site.
#
# Category subdomains (kesehatan.rusdimedia.com, ...) are deferred for
# launch (ENABLE_CATEGORY_SUBDOMAINS=false) - see docs/DEPLOY.md §7.1 for
# the wildcard block + Cloudflare DNS-01 setup this reintroduces once that
# feature is turned on; a wildcard hostname can't get a cert via HTTP-01,
# which is why that block isn't here right now.

# Apex + dashboard host + www (redirected to the apex by apps/web/proxy.ts
# itself, not here) all point at the same web app - proxy.ts is what
# actually keeps the reader-facing pages on the apex domain and redirects
# everything else to app.rusdimedia.com.
rusdimedia.com, app.rusdimedia.com, www.rusdimedia.com {
	reverse_proxy web:3100
}

api.rusdimedia.com {
	# Publicly-readable media objects (MinIO) served under the API host at
	# this one path, rather than a fourth DNS record - avoids needing
	# another subdomain just to expose the object storage bucket.
	handle /ainews-media/* {
		reverse_proxy minio:9000
	}
	handle {
		reverse_proxy api:4000
	}
}
