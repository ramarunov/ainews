node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/
.turbo/

# Environment
.env
.env.local
.env.*.local
# Real per-environment env files (docs/DEPLOY.md) - .env.example is the only
# env file meant to ever be committed.
.env.production
.env.staging

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
*.lcov
.nyc_output

# IDEs
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Prisma
prisma/migrations/dev.db

# Test artifacts
test-results/
playwright-report/

# Secrets
*.pem
*.key
*.cert
secrets/

# Database backups (contain plaintext-adjacent dumps — never commit)
apps/api/backups/
backups/

# WordPress export files (scripts/import-wordpress.ts input) - real site
# content/data dumps, not source, and can be tens of MB.
*.WordPress.*.xml
/*.xml

# Google Search Console exports (scripts/analyze-gsc-redirects.ts input) -
# real production analytics data, not source.
/GSC/

# Default output of scripts/generate-redirect-suggestions.ts and
# scripts/analyze-gsc-redirects.ts - generated CSVs derived from real site
# data, not source. Explicit OUTPUT_FILE/AUTO_OUTPUT_FILE/REVIEW_OUTPUT_FILE
# paths outside the repo avoid this entirely.
redirect-suggestions.csv
gsc-redirects-auto.csv
gsc-redirects-review.csv
